# =======================================================================
# Mobile (Flutter) — không phải file .env tự load. Flutter dùng
#   --dart-define=API_BASE_URL=...    khi flutter run / build.
# File này chỉ là CHEAT SHEET giá trị mặc định.
# =======================================================================

# Android emulator → host gateway = 10.0.2.2
# iOS simulator   → localhost
# Real device     → IP máy dev (vd 192.168.32.1:4000)
API_BASE_URL=http://192.168.32.1:4000

# Khi gọi trực tiếp ai-service (debug)
AI_BASE_URL=http://192.168.32.1:8000

# JWT debug (sau khi login lưu vào SecureStorage / SharedPreferences)
# Không hard-code token thực vào source.

# Ví dụ chạy local:
#   flutter run \
#     --dart-define=API_BASE_URL=http://10.0.2.2:4000 \
#     --dart-define=AI_BASE_URL=http://10.0.2.2:8000
