# =======================================================================
# docker-compose root .env  (đặt tại app/.env)
# Các biến này override defaults trong docker-compose.yml — chỉ cần khi
# bạn muốn đổi user/password Postgres hoặc bật model thật.
# =======================================================================

# Postgres local container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_ai

# Bật pipeline NLU/OCR thật trong container (tốn RAM nhiều)
USE_REAL_NLU=false
USE_REAL_OCR=false
