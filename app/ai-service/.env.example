# =======================================================================
# AI service (FastAPI) — copy thành .env và sửa cho local.
# Trong docker-compose, một số biến bị override (USE_REAL_*).
# =======================================================================

# --- App -----------------------------------------------------------------
APP_NAME="Expense AI Service"
ENVIRONMENT=local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Backend mode --------------------------------------------------------
# true  = load model thật từ expense-ocr-nlu (cần requirements-real.txt + weights)
# false = mock pipeline (regex + keyword) — phù hợp demo, không cần GPU.
# Bill OCR Retrain (WebAdmin auto-label) cần USE_REAL_OCR=true + weights VietOCR.
USE_REAL_NLU=false
USE_REAL_OCR=true

# true (default) = không load NLU/OCR weights lúc startup — load khi request đầu hoặc POST /internal/reload-models
LAZY_LOAD_MODELS=true

# Đường dẫn repo gốc (chỉ dùng khi USE_REAL_*=true)
EXPENSE_OCR_NLU_DIR=../../expense-ocr-nlu
OCR_WEIGHTS_PATH=../../expense-ocr-nlu/OCR/models/vietocr/vietocr_receipt.pth
LAYOUTLMV3_MODEL_DIR=../../expense-ocr-nlu/OCR/models/layoutlmv3_kie/model-best
LAYOUTLMV3_MODEL_DIR=../../expense-ocr-nlu/OCR/models/layoutlmv3_kie/model-best
VERIFIED_OCR_LABELS_DIR=../../expense-ocr-nlu/OCR/verified_ocr_labels
# Kaggle API (optional — retrain bill OCR)
# KAGGLE_CONFIG_DIR=../../app/backend
# Hoặc copy kaggle.json → %USERPROFILE%\.kaggle\kaggle.json (đã hỗ trợ cả hai)
# BILL_RETRAIN_WEBHOOK_URL=http://localhost:3000/api/admin/bill-retrain/kaggle/webhook
# BILL_RETRAIN_ARTIFACT_URL=https://your-bucket.s3.amazonaws.com/layoutlmv3_kie_artifacts.zip

# --- LLM (Gemini) — tuỳ chọn cho NLG Chitchat ---------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RUN_LLM=false

# (tuỳ chọn) backup model Llama qua Groq
LLAMA_API_KEY=
LLAMA_MODEL=llama-3.1-8b-instant

# --- Security ------------------------------------------------------------
# Nếu set, mọi request phải kèm header  X-API-Key: <giá trị>
API_KEY=
CORS_ORIGINS=*

# --- Rate-limit ----------------------------------------------------------
# RATE_LIMIT_PER_MINUTE=120
