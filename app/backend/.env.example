# =======================================================================
# Backend Orchestrator (Node.js / Express)
# Sao chép tệp này thành .env và điền các giá trị thực tế.
# =======================================================================

# --- Cấu hình ứng dụng ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Cơ sở dữ liệu (PostgreSQL / CockroachDB Cloud) ---
# Tùy chọn 1: CockroachDB Cloud Cluster
DATABASE_URL=postgresql://<username>:<password>@<host>:26257/spending-stories?sslmode=verify-full
DATABASE_SSL=no-verify
# Tùy chọn 2: PostgreSQL cục bộ
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/spending-stories
# DATABASE_SSL=false

# Đường dẫn tệp lược đồ khởi tạo cơ sở dữ liệu (tuỳ chọn)
# SCHEMA_SQL_PATH=/app/database/schema.sql

# --- Cấu hình JWT Authentication ---
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TTL=900             # 15 phút (giây)
JWT_REFRESH_TTL=2592000        # 30 ngày (giây)

# --- Dịch vụ AI Service (FastAPI) ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=120000
BILL_OCR_TIMEOUT_MS=300000
BILL_OCR_CONCURRENCY=2

# --- Cloudflare R2 Storage (Lưu trữ ảnh hóa đơn) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_TOKEN_VALUE=your_r2_token_value
R2_BUCKET=spending-stories
R2_REGION=auto
R2_PUBLIC_BASE_URL=https://pub-your-bucket-id.r2.dev
R2_PRESIGN_EXPIRES=3600

# --- Cấu hình CORS và Rate Limit ---
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Dữ liệu tài khoản mẫu ban đầu (Seed Data) ---
SEED_DEMO_USER_EMAIL=demo@money.local
SEED_DEMO_USER_PASSWORD=demo1234
SEED_DEMO_USER_NAME=Demo User

# --- Google Sign-In Authentication ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Firebase Cloud Messaging (FCM Push Notification) ---
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Tích hợp cổng thanh toán SePay (VietQR) ---
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret
HMAC-SHA256=your_sepay_webhook_secret
API_SEPAY=your_sepay_api_key
SEPAY_BANK=bidv
SEPAY_ACCOUNT_NUMBER=0000000001
SEPAY_ACCOUNT_NAME=SEPAY TEST ACCOUNT
SEPAY_DES=TKPMK

# --- Cấu hình gửi thư điện tử Nodemailer (Gmail SMTP) ---
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# --- Mật khẩu xác thực tái huấn luyện mô hình ---
PASSWORD_RETRAIN=your_admin_retrain_password
