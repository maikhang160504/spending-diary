# =======================================================================
# Backend (Node.js / Express)
# Copy thành .env và điền các secret. KHÔNG commit .env thật vào git.
# =======================================================================

# --- App -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Database ------------------------------------------------------------
# (A) Postgres local (mặc định khi chạy docker compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_ai
DATABASE_SSL=false

# (B) CockroachDB cloud (uncomment khi dùng cluster bên ngoài)
# DATABASE_URL=postgresql://<user>:<password>@<host>:26257/<db>?sslmode=verify-full
# DATABASE_SSL=true                       # hoặc no-verify nếu CA tự ký

# Tuỳ chọn override đường dẫn schema.sql (mặc định auto detect)
# SCHEMA_SQL_PATH=/app/database/schema.sql

# --- JWT -----------------------------------------------------------------
JWT_SECRET=please-change-me-in-prod
JWT_ACCESS_TTL=900             # 15 phút (giây)
JWT_REFRESH_TTL=2592000        # 30 ngày (giây)

# --- AI service ----------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=15000

# --- Cloudflare R2 (lưu ảnh hoá đơn / story) -----------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=spending-stories
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRES=3600

# --- CORS ----------------------------------------------------------------
# Trong production: liệt kê origin cụ thể, không để '*'
CORS_ORIGINS=*

# --- Rate-limit (nếu bật trong code) -------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Demo seed -----------------------------------------------------------
SEED_DEMO_USER_EMAIL=demo@money.local
SEED_DEMO_USER_PASSWORD=demo1234
SEED_DEMO_USER_NAME=Demo User

# --- Optional: webhook / observability -----------------------------------
# SENTRY_DSN=
# OPENTELEMETRY_OTLP_ENDPOINT=
